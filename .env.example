# ───────────────────────── LEXHUNT configuration ─────────────────────────
# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.
# Nothing in this file is required to boot locally except the auth variables.

# ── Authentication (REQUIRED) ──
# Generate a hash with:  npm run hash-password -- "your-password"
LEXHUNT_PASSWORD_HASH=
# Alternative for local dev only (plain text, not recommended in production):
# LEXHUNT_PASSWORD=change-me
# At least 32 random characters:  openssl rand -base64 48
SESSION_SECRET=

# ── Database ──
# Postgres connection string (Supabase: Project → Settings → Database → Connection pooling URI, port 6543).
# If unset, an embedded PGlite database is created in ./.data/pglite (local dev only; NOT persistent on Vercel).
DATABASE_URL=

# ── AI (Apply Smarter, CV extraction, approach emails) ──
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5
ANTHROPIC_MODEL=

# ── Scheduled jobs ──
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically when this is set.
CRON_SECRET=

# ── Job discovery providers (optional; each one that is set is used) ──
# JSearch on RapidAPI aggregates Google for Jobs (LinkedIn, Indeed, Bayt, Glassdoor, employer sites ...).
RAPIDAPI_KEY=
# SerpApi Google Jobs engine.
SERPAPI_KEY=
# Max provider queries per run (protects your API quota). Default 12.
DISCOVERY_MAX_QUERIES=

# ── Email alerts (optional) ──
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Must be a sender on a domain verified in Resend, e.g. "LEXHUNT <alerts@yourdomain.com>"
ALERT_EMAIL_FROM=

# Public URL of the deployment (used in email links and the crawler User-Agent)
APP_URL=http://localhost:3000
